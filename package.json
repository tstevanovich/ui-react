{
  "name": "ui-react",
  "version": "1.0.0",
  "main": "index.js",
  "groupId": "com.wellsfargo.1ibms",
  "scripts": {
    "dev": "npm run build:local:client && concurrently --kill-others-on-fail -n \"SERVER,CLIENT,RELOAD\" -c \"blue,green,magenta\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:reload\"",
    "dev:with:built:server": "npm run build:server && npm run build:local:client && concurrently --kill-others-on-fail -n \"SERVER,CLIENT,RELOAD\" -c \"blue,green,magenta\" \"cross-env ENABLE_LIVE_RELOAD=true node public/index.js\" \"npm run dev:client\" \"npm run dev:reload\"",
    "dev:with:built:client": "npm run build:local:client && concurrently --kill-others-on-fail -n \"SERVER,RELOAD\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:reload\"",
    "dev:server": "cd ./server && cross-env ENABLE_LIVE_RELOAD=true npm run dev",
    "dev:client": "cd ./client && npm run build:local:watch",
    "dev:reload": "node ./server/live-reload.js",
    "install": "concurrently --raw -n \"SERVER,CLIENT\" -c \"blue,green\" \"cd ./server && npm install\" \"cd ./client && npm install\"",
    "start": "node public/index.js",
    "build": "npm run build:clean && npm run build:server && npm run build:client",
    "build:local:client": "cd ./client && npm run build:local",
    "build:clean": "rimraf public/",
    "build:server": "cd ./server && npm run build",
    "build:client": "cd ./client && npm run build",
    "pack": "npm pack --loglevel warn",
    "test": "npm run test:client && npm run test:server && npm run test:libraries",
    "test:server": "npm --prefix server test -- --runInBand",
    "test:client": "npm --prefix client test",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:client": "eslint client --max-warnings 0",
    "lint:server": "eslint server --max-warnings 0",
    "lint:styles": "stylelint \"client/src/**/*.{css,scss}\"",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm --prefix client run typecheck && npm --prefix server run typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test:libraries": "npm --prefix client run test:wf && npm --prefix server run test:wf",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run lint:styles && npm run format:check && npm run typecheck && npm test",
    "mcp:playwright": "node node_modules/@playwright/mcp/cli.js --browser msedge --headless --isolated",
    "pretest:e2e": "npm run build:server && npm run build:local:client",
    "mcp:check": "node tooling/check-mcp.mjs",
    "mcp:setup:react": "node tooling/build-react-mcp.mjs",
    "mcp:react": "node tooling/run-react-mcp.mjs",
    "mcp:mui": "node node_modules/@mui/mcp/stdio.js",
    "mcp:check:online": "node tooling/check-mcp.mjs --online"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.9",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8",
    "@eslint/js": "9.39.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@mui/mcp": "0.1.6",
    "@playwright/mcp": "0.0.82",
    "@playwright/test": "1.51.0",
    "@types/node": "24.3.0",
    "algoliasearch": "5.59.0",
    "cheerio": "1.2.0",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "16.5.0",
    "html-to-text": "9.0.5",
    "invariant": "2.2.4",
    "prettier": "3.8.1",
    "pretty-format": "24.9.0",
    "puppeteer": "25.12.0",
    "rimraf": "5.0.5",
    "stylelint": "17.0.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "zod": "4.6.5",
    "zod-validation-error": "4.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
