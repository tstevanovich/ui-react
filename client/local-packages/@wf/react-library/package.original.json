{
  "name": "@wf/react-library",
  "version": "21.2.0",
  "groupId": "com.wellsfargo.ebssh",
  "description": "Orchestra React Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "postbuild": "npm pack",
    "pack": "npm pack",
    "lint": "eslint src",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "rimraf coverage && jest --runInBand --coverage",
    "test:local": "jest",
    "test:one:coverage": "rimraf coverage && jest ./src/services/logger/WfLogger.service.spec.ts --coverage",
    "test:one": "jest ./src/components/template/TemplateLayout.test.tsx",
    "test:debug:one": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand ./src/components/template/Callback.test.tsx --watch",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "version:snapshot": "npm version prerelease --preid-snapshot",
    "version:release": "npm version patch",
    "publish:lib": "node publish.js"
  },
  "author": "",
  "license": "ISC",
