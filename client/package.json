{
  "name": "client",
  "version": "0.0.1",
  "main": "index.js",
  "//": [
    "For building in local use build:local script and build script will be triggered by the jenkins pipeline for building the project."
  ],
  "scripts": {
    "start": "webpack serve --mode development --config ./webpack.config.development.js",
    "start:prod": "webpack serve --mode production --config ./webpack.config.production.js",
    "build:pre": "node update-app-config.js",
    "build": "npm run build:pre && webpack --mode production --config ./webpack.config.production.js",
    "build:local": "webpack --mode production --config ./webpack.config.production.js",
    "build:local:watch": "webpack --mode development --watch --config ./webpack.config.development.js",
    "build:local:dev": "webpack --mode development --config ./webpack.config.development.js",
    "pack": "npm pack",
    "test:local": "jest",
    "test": "rimraf coverage && jest --runInBand --coverage"
  },
